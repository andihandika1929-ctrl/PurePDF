# PurePDF Frontend Environment Configuration

# Backend Python FastAPI Service URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase Auth & Database (Google OAuth, User Profiles, Usage Logs)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Only Supabase Service Role Key (NEVER expose as NEXT_PUBLIC_)
# Required for /api/admin/users and /api/webhooks/payment
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Secret Admin Dashboard Route & Server-Side Admin Email
ADMIN_SECRET_PATH=6664dm1n
ADMIN_EMAIL=admin@purepdf.app

# Payment Gateway Webhook Secret Key (Required — fails closed if omitted)
PAYMENT_SERVER_KEY=

# Google AdSense (Optional — leave empty for clean placeholders; auto-activates when set)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
ADSENSE_PUBLISHER_ID=
