# PurePDF Frontend Environment Configuration

# Backend Python FastAPI Service URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase Auth & Database (Google OAuth, User Profiles, Usage Logs)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret Admin Dashboard Route
# Secret path: e.g. /6664dm1n (any other route returns 404 Not Found)
ADMIN_SECRET_PATH=6664dm1n
ADMIN_EMAIL=admin@purepdf.app

# Payment Gateway Webhook Secret Key (for HMAC SHA-512 validation)
PAYMENT_SERVER_KEY=purepdf_whsec_secret_key_12345
