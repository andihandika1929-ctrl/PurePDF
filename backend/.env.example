# PurePDF Python FastAPI PRO Engine Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.vercel.app

# Supabase Auth & Server Billing Verification (Required for JWT verification & atomic credits)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Key (for Neural Scanned Text Editing & Inpainting)
