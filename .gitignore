# PurePDF Root .gitignore

# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Environment & Secret files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
frontend/.env.local
frontend/.env.*.local

# Next.js build output
frontend/.next/
frontend/out/
.next/
out/
build/
dist/

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.temp/
temp/
tmp/

# OS files
.DS_Store
Thumbs.db
